# Monorepo Environment Variables Reference

# NestJS Server (.env in server/)
PORT=4000
CORS_ORIGIN=*

# Next.js Web Dashboard (.env.local in web/)
NEXT_PUBLIC_SIGNALING_SERVER=http://localhost:4000

# Raspberry Pi Agent (.env in pi-agent/)
DEVICE_ID=rover-01
SIGNALING_SERVER=http://192.168.1.10:4000
ALSA_PLAYBACK_DEVICE=plughw:0,0
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
